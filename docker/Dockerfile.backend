FROM node:20-slim

# Install OpenSSL 1.1 package for 100% Prisma Query Engine compatibility
RUN apt-get update && apt-get install -y openssl libssl-dev python3 make g++ curl wget && \
    wget http://archive.debian.org/debian/pool/main/o/openssl/libssl1.1_1.1.1n-0+deb11u5_amd64.deb && \
    dpkg -i libssl1.1_1.1.1n-0+deb11u5_amd64.deb && \
    rm libssl1.1_1.1.1n-0+deb11u5_amd64.deb && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package specs
COPY backend/package*.json ./
RUN npm ci --frozen-lockfile

# Copy backend source & prisma schema
COPY backend/ .
COPY prisma/ /app/prisma/

# Generate Prisma client for all target environments
RUN npx prisma generate --schema=/app/prisma/schema.prisma

# Build TypeScript
RUN npm run build

EXPOSE 3000

# Entrypoint: run migrations then start server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=/app/prisma/schema.prisma && node dist/server.js"]
