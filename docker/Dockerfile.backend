FROM node:20

# Create OpenSSL 1.1 symlinks for Prisma Engine compatibility on OpenSSL 3 systems
RUN ln -s /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libssl.so.1.1 || true
RUN ln -s /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.1.1 || true

WORKDIR /app

# Copy package specs
COPY backend/package*.json ./
RUN npm ci --frozen-lockfile

# Copy backend source & prisma schema
COPY backend/ .
COPY prisma/ /app/prisma/

# Generate Prisma client for all target environments
RUN npx prisma generate --schema=/app/prisma/schema.prisma

# Build TypeScript
RUN npm run build

EXPOSE 3000

# Entrypoint: run migrations then start server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=/app/prisma/schema.prisma && node dist/server.js"]
