FROM node:20-slim

# Install OpenSSL & build dependencies for native modules and Prisma
RUN apt-get update && apt-get install -y openssl python3 make g++ curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY backend/package*.json ./
RUN npm ci --frozen-lockfile

# Copy source + prisma schema
COPY backend/ .
COPY prisma/ /app/prisma/

# Generate Prisma client
RUN npx prisma generate --schema=/app/prisma/schema.prisma

# Build TypeScript
RUN npm run build

EXPOSE 3000

# Entrypoint: run migrations then start server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=/app/prisma/schema.prisma && node dist/server.js"]
