FROM node:20-bullseye-slim

RUN apt-get update && apt-get install -y openssl libssl1.1 ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package specs
COPY backend/package*.json ./
RUN npm ci --frozen-lockfile

# Copy backend source & prisma schema
COPY backend/ .
COPY prisma/ /app/prisma/

# Generate Prisma client for all target binary engines
RUN npx prisma generate --schema=/app/prisma/schema.prisma

# Build TypeScript
RUN npm run build

EXPOSE 3000

# Entrypoint: run migrations then start server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=/app/prisma/schema.prisma && node dist/server.js"]
