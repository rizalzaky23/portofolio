// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum ProjectCategory {
  WEB
  MOBILE
  DESKTOP
  DEVOPS
  AI_ML
  OTHER
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  description  String          @db.Text
  content      String          @db.Text
  category     ProjectCategory @default(WEB)
  tags         String          // JSON array string
  featured     Boolean         @default(false)
  order        Int             @default(0)
  demoUrl      String?
  repoUrl      String?
  thumbnailUrl String?
  images       String?         @db.Text // JSON array string
  published    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("projects")
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  position    String
  location    String?
  type        String    @default("Full-time") // Full-time, Contract, Freelance, etc.
  description String    @db.Text
  skills      String    // JSON array string
  startDate   DateTime
  endDate     DateTime? // Null = current job
  isCurrent   Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("experiences")
}

model Education {
  id          String   @id @default(uuid())
  institution String
  degree      String
  field       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("educations")
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  category  String   // Frontend, Backend, DevOps, Tools, etc.
  level     Int      @default(80) // 1-100
  icon      String?  // Icon name or SVG
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

model Certification {
  id             String    @id @default(uuid())
  name           String
  issuer         String
  issueDate      DateTime
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  imageUrl       String?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("certifications")
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique // hero, about, contact, settings, etc.
  content   String   @db.LongText // JSON content
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
