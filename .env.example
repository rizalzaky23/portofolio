# ─────────────────────────────────────────────────────────────────────────────
# Portfolio + CMS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
# Runtime environment (development | production | test)
NODE_ENV=development

# Backend server port
PORT=3000

# URL of the frontend app (used for CORS)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL connection URL (Prisma format)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://portfolio:portfoliopassword@localhost:3306/portfolio

# MySQL credentials (used by Docker Compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=portfoliopassword

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Access token secret (at least 64 chars, randomly generated)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-at-least-64-characters-long-please-change-this

# Refresh token secret (different from JWT_SECRET)
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-access-token-secret-here

# Access token expiry (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
# MinIO server hostname (use 'minio' inside Docker Compose network)
MINIO_ENDPOINT=localhost

# MinIO API port (default: 9000)
MINIO_PORT=9000

# Use SSL (true in production with HTTPS MinIO)
MINIO_USE_SSL=false

# MinIO access key (username)
MINIO_ACCESS_KEY=minioadmin

# MinIO secret key (password) — use a strong password in production
MINIO_SECRET_KEY=minioadmin123

# MinIO bucket name (will be auto-created if it doesn't exist)
MINIO_BUCKET_NAME=portfolio

# Public-facing URL for serving MinIO files
# In Docker Compose: use the Nginx proxy URL, not the internal service URL
# Example production: https://media.rizalzaky.dev
MINIO_PUBLIC_URL=http://localhost:9000
